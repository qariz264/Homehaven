# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PAYSTACK CONFIGURATION (Use sk_live_... and pk_live_... for real live payments)
PAYSTACK_SECRET_KEY="sk_live_your_live_secret_key"
PAYSTACK_PUBLIC_KEY="pk_live_your_live_public_key"

# FIREBASE ADMIN (Required for backend callbacks)
# You will need to download the service account JSON and provide these values
FIREBASE_PROJECT_ID="your_project_id"
FIREBASE_CLIENT_EMAIL="your_client_email"
FIREBASE_PRIVATE_KEY="your_private_key"

# INTERNAL ADMIN API KEY (Optional: for securing internal server maintenance endpoints)
ADMIN_SECRET="your_optional_internal_admin_secret_token"

# EMAIL VERIFICATION / OTP CONFIGURATION (SMTP or Resend)
# Optional: If not provided, OTP verification runs in simulated sandbox mode with instant codes displayed in the UI.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="HomeHaven Kenya <noreply@homehaven.co.ke>"
RESEND_API_KEY="re_your_resend_api_key"
